# n8n basic auth
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme

# Host / Webhook
N8N_HOST=localhost
WEBHOOK_URL=https://your-public-url.example.com/webhook

# Postgres
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=n8n

# Google OAuth2 / calendários por unidade (Fase 3)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-public-url.example.com/rest/oauth2-credential/callback
GOOGLE_CALENDAR_PATO_BRANCO=REPLACE_CALENDAR_PATO_BRANCO
GOOGLE_CALENDAR_SAO_CARLOS=REPLACE_CALENDAR_SAO_CARLOS

# LLM + RAG (Fase 7) — ver config/llm.json e specs/007-llm-e-rag
# off = só templates | shadow = LLM roda mas paciente recebe template | on = LLM com verificador
LLM_MODE=off
LLM_PROVIDER=gemini
# Confira os nomes com: python -m app.interfaces.cli.treino checar-gemini
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# WhatsApp Cloud API (Meta). Nunca commitar valores reais.
# Verify token: texto livre que você escolhe e informa no painel da Meta ao cadastrar o webhook.
META_VERIFY_TOKEN=troque-por-um-texto-longo-e-aleatorio
# App Secret (Configurações do app > Básico): usado para validar a assinatura de cada webhook.
META_APP_SECRET=
# Token de acesso (de preferência permanente, via usuário do sistema) e ID do número no Cloud API.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_API_VERSION=v21.0

# Timezone
TZ=America/Sao_Paulo

# Serviço Python (Fase 1)
PORT=8001

# Gemini: redator LLM, embeddings do RAG e teste de conexão do TPM Console (Google AI Studio)
GEMINI_API_KEY=

# Logs do serviço Python (desenvolvimento)
LOG_LEVEL=INFO
# TURN_LOG_PATH=logs/turns.jsonl
# LOG_MESSAGE_TEXT=1   # grava o texto do paciente no log: só em máquina local (LGPD)
